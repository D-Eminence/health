{
  "name": "hid-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Health ID frontend ecosystem. Consumer of the Health ID Gateway/API. Contains no backend code.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build:public-web": "npm run build --workspace @hid/public-web",
    "build:patient-web": "npm run build --workspace @hid/patient-web",
    "audit:boundaries": "node scripts/check-boundaries.mjs",
    "audit:launch-build": "node scripts/check-launch-build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.0",
    "eslint": "^9.39.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  }
}
