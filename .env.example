# Health ID frontend: public configuration only.
#
# Every variable here is inlined into a browser bundle and is therefore public.
# Secrets, service-role keys, AWS or Cloudflare credentials and internal service
# endpoints never appear in this file or in any deployment's public variables;
# they belong behind the Health ID Gateway. `assertPublicEnvironment` fails the
# build if one appears.
#
# Copy per application:
#   apps/public-web/.env.local     (Next.js: NEXT_PUBLIC_HID_*)
#   apps/patient-web/.env.local    (Vite: VITE_HID_*)

# --- Next.js applications ---------------------------------------------------
# local | staging | production
NEXT_PUBLIC_HID_ENVIRONMENT=local
# Browser API origin. In local development, Next proxies /api/v1 to the gateway.
NEXT_PUBLIC_HID_API_BASE_URL=http://localhost:3100
NEXT_PUBLIC_HID_APP_ORIGIN=http://localhost:3100
NEXT_PUBLIC_HID_PORTAL_ORIGIN=http://localhost:3200
# Cloudflare Turnstile *site* key. The secret half stays server-side.
NEXT_PUBLIC_HID_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_HID_SENTRY_DSN=
NEXT_PUBLIC_HID_SUPPORT_CHAT_ENABLED=false
NEXT_PUBLIC_HID_PATIENT_CHAT_ENABLED=false
NEXT_PUBLIC_HID_SUPPORT_CONTACT=mailto:support@healthidentitydirectory.com

# --- Vite applications ------------------------------------------------------
VITE_HID_ENVIRONMENT=local
# The authenticated portal serves /api/v1 through its local Vite proxy.
VITE_HID_API_BASE_URL=http://localhost:3200
VITE_HID_APP_ORIGIN=http://localhost:3200
VITE_HID_TURNSTILE_SITE_KEY=
# Public Google OAuth client ID for patient sign-in/onboarding (optional).
VITE_HID_GOOGLE_CLIENT_ID=
VITE_HID_SENTRY_DSN=
VITE_HID_SUPPORT_CHAT_ENABLED=false
VITE_HID_PATIENT_CHAT_ENABLED=false
# Provider chart features whose routes hid-system main does not serve (they are
# on its staging branches). Set to true only for a backend that serves them.
VITE_HID_IMPORTED_RECORDS_ENABLED=false
VITE_HID_STAFF_PATIENT_CHAT_ENABLED=false
VITE_HID_SUPPORT_CONTACT=mailto:support@healthidentitydirectory.com

# Development server only; never bundled into the browser. The local backend
# must allow http://localhost:3100 and http://localhost:3200 in CORS_ORIGINS.
HID_LOCAL_GATEWAY_ORIGIN=http://localhost:3000
